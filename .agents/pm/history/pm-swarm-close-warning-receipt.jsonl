{"hash_algorithm":"sha256","ts":"2026-10-27T14:32:22.495Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"f1c616668dfdb0e0cf9ed9c4","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-swarm-close-warning-receipt"},{"op":"add","path":"/metadata/title","value":"Recover native dependency warnings after an interrupted close"},{"op":"add","path":"/metadata/description","value":"Swarm now preserves all native close warnings when available and reports warnings_unavailable with an explicit inspect-dependent-items remedy when the SDK interrupted before its close result checkpoint. Native item and history recovery still converges without duplicate closes. The pinned public CommitWorkspaceTransactionOptions.onTransition contract defines step_applied after mutation and before journal recording; PmClient.close returns ephemeral warnings, and commitItemMutations delegates to the same coordinator lock. No public native-close result receipt API can recover those warnings at that boundary. Upstream issue search found no open matching warning-receipt issue. Follow up when the SDK durably records the native result before that interruption boundary; retain the conservative availability signal for legacy journals."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"blocked"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["durability","sdk-gap"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-27T14:32:22.495Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-27T14:32:22.495Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/parent","value":"pm-swarm-y972"},{"op":"add","path":"/metadata/blocked_reason","value":"Pinned SDK exposes step_applied before persisting the native result and exports no durable native-close warning receipt; an upstream SDK change is needed."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"ed42deb0d71a3fc5e153478bcb4debb94c3d9e0cae2e644eb9b555ba0def3da8","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"1cf9c34629b673d60a66709b063ec71726c3a8bd35696aecf510df7ed1b6fedb"}
