{"hash_algorithm":"sha256","ts":"2026-10-25T10:11:49.433Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"f1c616668dfdb0e0cf9ed9c4","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-swarm-write-free-reads"},{"op":"add","path":"/metadata/title","value":"Require write-free SDK current reads for cold refusal invariance"},{"op":"add","path":"/metadata/description","value":"Pinned SDK 2026.10.23 PmClient.get records derived context usage for current reads; full current gets and listAllComplete can materialize metadata caches. PmClientOptions, GetOptions and PmCompleteListOptions expose no per-call no-write mode. Public createMutationGuardSdk.get provides a pure local metadata lookup and is used for package admission, but its list method uses the persistent cache. Cold corpus-dependent or provider-owned refusals cannot yet promise zero SDK runtime writes without a write-free certified-list/current-read capability. Preserve SDK-owned caches and usage records; do not disable configuration or reimplement tracker listing. Orchestrator to report the missing SDK capability upstream."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["privacy","sdk-gap"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-25T10:11:49.433Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-25T10:11:49.433Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/parent","value":"pm-swarm-y972"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"78774fdd337acbf