er/pre-close bytes digest/post-close history domain before restore, fsync intent, progress and parent-directory updates; durable per-member restored/pending receipts recover own progress without mistaking it for peers; never restore peers or foreign records, and release/claim/restore ABA must be detected from locked native history heads even when all bytes and tokens match; real-process SIGKILL after every forward and reverse step including 0..N member restores with 1-3 dependents converges to exact pre-close item bytes with append-only audit history, no duplicates or loss; peer edits between restores stop with typed partial receipts preserving restored and pending members; lost native returns and ordinary coordinator failures preserve all lifecycle members coherently; packed npm/Bun, non-Git and installed separate/shared SDK layouts exercise every boundary; property tests, revert proofs, full 100 percent coverage, documentation and release gates."},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-swarm-y972","kind":"related","created_at":"2026-10-27T19:53:07.216Z","author":"codex-agent","source_kind":"cli:create:dep","author_source":"detected"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"f6ed3e20094fd4ef2c08422a1a4adc75f4f1f9086af6530423df1ca725c70795","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"79decda95d4681018b7d646b7f7789f10d886705b7cd72e7bba379681369043f"}
